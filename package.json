{
  "name": "antdv-pro-next",
  "type": "module",
  "version": "1.0.0",
  "description": "A admin template for antdv-next",
  "author": {
    "name": "ducheng1",
    "email": "w729567588@163.com"
  },
  "scripts": {
    "dev": "vite",
    "build:test": "vite build --mode test",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "run-p lint:* format",
    "lint:code": "eslint --ext .js,.jsx,.ts,.tsx,.vue,.json --fix",
    "lint:type": "vue-tsx --noEmit --skipLib",
    "lint:style": "stylelint **/*.{css,scss,vue} --fix",
    "format": "prettier . --write --ignore-unknown",
    "up": "npx taze minor -wI",
    "commitlint": "commitlint --edit",
    "commit": "git add . && git cz",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "alova": "^3.5.1",
    "antdv-next": "^1.1.3",
    "dayjs": "^1.11.19",
    "es-toolkit": "^1.45.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@alova/mock": "^2.0.20",
    "@antdv-next/auto-import-resolver": "^1.0.6",
    "@antfu/eslint-config": "^7.7.0",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@types/node": "^24.12.0",
    "@types/postcss-pxtorem": "^6.1.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vue/tsconfig": "^0.9.0",
    "autoprefixer": "^10.4.27",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "nano-staged": "^0.9.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.8",
    "postcss-html": "^1.8.1",
    "postcss-pxtorem": "^6.1.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.1",
    "sass": "^1.98.0",
    "stylelint": "^17.4.0",
    "stylelint-config-recess-order": "^7.6.1",
    "stylelint-config-recommended-scss": "^17.0.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-order": "^8.0.0",
    "stylelint-prettier": "^5.0.3",
    "terser": "^5.46.0",
    "typescript": "~5.9.3",
    "unocss": "^66.6.6",
    "unocss-preset-animations": "^1.3.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-turbo-console": "^2.3.0",
    "unplugin-vue-components": "^31.0.0",
    "unplugin-vue-router": "^0.19.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vue-tsc": "^3.2.5"
  },
  "nano-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{js,jsx,ts,tsx,vue,json}": "eslint --fix",
    "*.{css,scss,vue}": "stylelint --fix"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
